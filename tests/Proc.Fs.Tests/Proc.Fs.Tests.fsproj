<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- TUnit test projects are self-hosting Microsoft.Testing.Platform executables; F# has no source generators,
         so TUnit discovers these tests by reflection -->
    <OutputType>Exe</OutputType>
    <AssemblyName>Proc.Fs.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <LangVersion>Latest</LangVersion>
    <!-- The tests deliberately exercise the obsolete aliases too -->
    <NoWarn>$(NoWarn);FS0044</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Assert.fs" />
    <Compile Include="TestBinary.fs" />
    <Compile Include="ExecTests.fs" />
    <Compile Include="CmdTests.fs" />
    <Compile Include="ShellTests.fs" />
    <Compile Include="ShellSyntaxTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <ProjectReference Include="..\..\src\Proc.Fs\Proc.Fs.fsproj" />
    <!-- Not referenced for its API: makes sure the NativeAOT test binary is built and published first -->
    <ProjectReference Include="..\Proc.Tests.Binary\Proc.Tests.Binary.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="TUnit" />
  </ItemGroup>
</Project>

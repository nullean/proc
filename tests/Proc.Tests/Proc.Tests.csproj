<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- TUnit test projects are self-hosting Microsoft.Testing.Platform executables -->
    <OutputType>Exe</OutputType>
    <AssemblyName>Proc.Tests</AssemblyName>
    <RootNamespace>ProcNet.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <LangVersion>preview</LangVersion>
    <!-- assertions are AwesomeAssertions; do not bring TUnit's own Assert.That into scope -->
    <TUnitAssertionsImplicitUsings>false</TUnitAssertionsImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Proc\Proc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Reactive.Linq" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="TUnit" />
  </ItemGroup>
</Project>

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- the library -->
  <ItemGroup>
    <PackageVersion Include="System.Reactive" Version="5.0.0" />
    <!-- Proc.Fs's floor for consumers; the tests and the build use the same version -->
    <PackageVersion Include="FSharp.Core" Version="10.0.100" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net40" Version="1.0.3" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net461" Version="1.0.3" />
    <PackageVersion Include="MinVer" Version="6.0.0" />
  </ItemGroup>

  <!-- tests -->
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="System.Reactive.Linq" Version="4.4.1" />
    <PackageVersion Include="TUnit" Version="1.83.0" />
  </ItemGroup>

  <!-- build/scripts -->
  <ItemGroup>
    <PackageVersion Include="Argu" Version="6.0.0" />
    <PackageVersion Include="Bullseye" Version="6.0.0" />
    <PackageVersion Include="Fake.Tools.Git" Version="5.15.0" />
    <PackageVersion Include="Proc" Version="0.9.1" />
  </ItemGroup>
</Project>

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- the library -->
  <ItemGroup>
    <PackageVersion Include="System.Reactive" Version="5.0.0" />
    <!-- Proc.Fs's floor for consumers, which the tests use too; build/scripts overrides it for Nullean.Make.Fs -->
    <PackageVersion Include="FSharp.Core" Version="10.0.100" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net40" Version="1.0.3" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net461" Version="1.0.3" />
    <PackageVersion Include="MinVer" Version="6.0.0" />
  </ItemGroup>

  <!-- tests -->
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="System.Reactive.Linq" Version="4.4.1" />
    <PackageVersion Include="TUnit" Version="1.83.0" />
  </ItemGroup>

  <!-- build/scripts -->
  <ItemGroup>
    <PackageVersion Include="Nullean.Make.Fs" Version="0.25.0" />
    <!-- the released package, which Nullean.Make.Fs would otherwise resolve at its 0.17.0 floor -->
    <PackageVersion Include="Proc.Fs" Version="0.18.0" />
  </ItemGroup>
</Project>
